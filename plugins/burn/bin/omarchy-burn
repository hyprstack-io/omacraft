#!/bin/bash
# Burn My Windows for Omarchy: window open and close effects.
#
#   omarchy-burn close                     close the active window with an effect
#                                          (falls back to a plain close)
#   omarchy-burn preview [EFFECT] [open|close|both]
#                                          play an effect on the active window
#   omarchy-burn list [--json]             the effects
#   omarchy-burn status [--json]           the settings
#   omarchy-burn on|off                    all effects
#   omarchy-burn open|close on|off         effects for opening or closing windows
#   omarchy-burn open|close effects ID...  pick from these at random ("random" = any)
#   omarchy-burn open|close speed N        0.25 (slow) to 3 (fast)
#   omarchy-burn intensity N               0.25 to 2.5
#   omarchy-burn color effect|theme|#hex   each effect's own colours, the theme accent, or yours
#   omarchy-burn exclude add|remove CLASS  windows that never get effects
#   omarchy-burn skip floating|fullscreen on|off
#   omarchy-burn keys on|off               SUPER+W / SUPER+Q close through the effects
#   omarchy-burn rescue                    show any window a crashed shell left hidden
#
# Settings live in ~/.config/omarchy/burn-my-windows.json and the shell picks
# them up as soon as they change.
set -uo pipefail

here="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"
config="${XDG_CONFIG_HOME:-$HOME/.config}"
settings="$config/omarchy/burn-my-windows.json"
hypr="$config/hypr"
keys_file="$hypr/burn_my_windows.lua"
catalog="$here/effects.json"

defaults='{
  "enabled": true,
  "open": { "enabled": true, "effects": ["glide"], "speed": 1.0 },
  "close": { "enabled": true, "effects": ["fire"], "speed": 1.0 },
  "intensity": 1.0,
  "color": "effect",
  "exclude": ["org.omarchy.screensaver"],
  "skipFloating": false,
  "skipFullscreen": true,
  "keys": true
}'

die() { echo "omarchy-burn: $*" >&2; exit 1; }

current() {
  if [[ -s $settings ]]; then
    jq -c --argjson d "$defaults" '$d * .' "$settings" 2>/dev/null || echo "$defaults"
  else
    jq -c . <<<"$defaults"
  fi
}

# Writes in place (not through a rename) so the shell's file watcher stays put.
update() { # jq filter, args...
  local filter="$1" next
  shift
  mkdir -p "$(dirname "$settings")"
  next="$(current | jq "$@" "$filter")" || die "couldn't update $settings"
  printf '%s\n' "$next" >"$settings"
}

ids() { jq -r '.effects[].id' "$catalog"; }

on_off() {
  case "${1:-}" in
    on | true | yes | 1) echo true ;;
    off | false | no | 0) echo false ;;
    *) die "expected on or off, got '${1:-}'" ;;
  esac
}

number() { # value min max
  [[ ${1:-} =~ ^[0-9]*\.?[0-9]+$ ]] || die "expected a number, got '${1:-}'"
  awk -v v="$1" -v lo="$2" -v hi="$3" 'BEGIN { if (v < lo) v = lo; if (v > hi) v = hi; printf "%.2f", v }'
}

shell_call() { omarchy-shell burn "$@" >/dev/null 2>&1; }

write_keys() { # true|false
  # Bind through the installed plugin, so the keys follow it if it moves.
  local cmd="$config/omarchy/plugins/omacraft.burn/bin/omarchy-burn"
  [[ -x $cmd ]] || cmd="$here/bin/omarchy-burn"
  mkdir -p "$hypr"
  {
    echo "-- Generated by the omacraft.burn shell plugin: omarchy-burn keys on|off."
    echo "-- The effects layer pops in and out without Hyprland's layer animation."
    echo 'hl.layer_rule({ match = { namespace = "omarchy-burn" }, no_anim = true, animation = "none" })'
    if [[ $1 == true ]]; then
      echo
      echo "-- Closing goes through the shell so it can copy the window first."
      echo "-- omarchy-burn close falls back to a plain close if the shell is down."
      for key in "SUPER + W" "SUPER + Q"; do
        echo "hl.unbind(\"$key\")"
        echo "o.bind(\"$key\", \"Close window\", \"$cmd close\")"
      done
    fi
  } >"$keys_file"
  local main="$hypr/hyprland.lua"
  if [[ -f $main ]] && ! grep -q 'hypr.burn_my_windows' "$main"; then
    cp -p "$main" "$main.before-burn-$(date +%s)"
    printf '\n-- Window effects, generated by the omacraft.burn shell plugin.\npcall(require, "hypr.burn_my_windows")\n' >>"$main"
  fi
  hyprctl reload >/dev/null 2>&1 || true
}

side() { # open|close, then a sub-command
  local which="$1" what="${2:-}"
  shift 2 || true
  case "$what" in
    on | off) update ".$which.enabled = \$v" --argjson v "$(on_off "$what")" ;;
    speed) update ".$which.speed = \$v" --argjson v "$(number "${1:-}" 0.25 3)" ;;
    effects)
      (($# > 0)) || die "name at least one effect"
      local list=() id
      for id in "$@"; do
        id="${id//,/ }"
        for one in $id; do
          [[ $one == random ]] || ids | grep -qx "$one" || die "no effect called '$one' (see omarchy-burn list)"
          list+=("$one")
        done
      done
      update ".$which.effects = \$v" --argjson v "$(printf '%s\n' "${list[@]}" | jq -R . | jq -sc .)"
      ;;
    "") current | jq ".$which" ;;
    *) die "omarchy-burn $which on|off|speed N|effects ID..." ;;
  esac
}

case "${1:-help}" in
  close)
    if (($# == 1)); then
      shell_call close || hyprctl dispatch 'hl.dsp.window.close()' >/dev/null
    else
      side close "${@:2}"
    fi
    ;;
  preview)
    effect="${2:-}" direction="${3:-both}"
    [[ -z $effect ]] || ids | grep -qx "$effect" || die "no effect called '$effect'"
    case "$direction" in
      both) shell_call preview "$effect" ;;
      open) shell_call previewOpen "$effect" ;;
      close) shell_call previewClose "$effect" ;;
      *) die "preview direction is open, close or both" ;;
    esac || die "the shell isn't running the omacraft.burn plugin"
    ;;
  list)
    if [[ ${2:-} == --json ]]; then jq -c .effects "$catalog"; else
      jq -r '.effects[] | "\(.id)\t\(.name)\t\(.description)"' "$catalog" | column -t -s $'\t'
    fi
    ;;
  status)
    if [[ ${2:-} == --json ]]; then current; else current | jq .; fi
    ;;
  on | off) update '.enabled = $v' --argjson v "$(on_off "$1")" ;;
  open) side open "${@:2}" ;;
  intensity) update '.intensity = $v' --argjson v "$(number "${2:-}" 0.25 2.5)" ;;
  color | colour)
    value="${2:-}"
    [[ $value == effect || $value == theme || $value =~ ^#[0-9a-fA-F]{6}([0-9a-fA-F]{2})?$ ]] ||
      die "color is effect, theme or #rrggbb"
    update '.color = $v' --arg v "$value"
    ;;
  exclude)
    case "${2:-}" in
      add) update '.exclude = ((.exclude // []) + [$v] | unique)' --arg v "${3:?class}" ;;
      remove) update '.exclude = ((.exclude // []) - [$v])' --arg v "${3:?class}" ;;
      *) current | jq -r '.exclude[]' ;;
    esac
    ;;
  skip)
    case "${2:-}" in
      floating) update '.skipFloating = $v' --argjson v "$(on_off "${3:-}")" ;;
      fullscreen) update '.skipFullscreen = $v' --argjson v "$(on_off "${3:-}")" ;;
      *) die "omarchy-burn skip floating|fullscreen on|off" ;;
    esac
    ;;
  keys)
    value="$(on_off "${2:-}")"
    update '.keys = $v' --argjson v "$value"
    write_keys "$value"
    ;;
  rescue) shell_call rescue || "$here/bin/burn-window" rescue ;;
  help | -h | --help) sed -n '2,22p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) die "unknown command '$1' (omarchy-burn help)" ;;
esac
