pkgbase = omacraft
	pkgdesc = One home for the Omarchy shell plugins, Dotfile Generator and the OmaBuilds ISO builder
	pkgver = 0.3.0
	pkgrel = 1
	url = https://github.com/hyprstack-io/omacraft
	install = omacraft.install
	arch = x86_64
	arch = aarch64
	license = MIT
	license = Apache-2.0
	makedepends = gcc
	makedepends = make
	makedepends = rsync
	depends = qt6-base
	depends = qt6-declarative
	depends = qt6-wayland
	depends = qt6-svg
	depends = qt6-imageformats
	depends = qt6-webengine
	depends = layer-shell-qt
	depends = hyprland>=0.53
	depends = quickshell
	depends = ttf-jetbrains-mono-nerd
	depends = xdg-desktop-portal
	depends = polkit
	depends = python
	depends = python-pillow
	depends = nodejs
	depends = jq
	depends = curl
	depends = git
	depends = fontconfig
	depends = zstd
	depends = unzip
	depends = inotify-tools
	depends = libnotify
	depends = gtk3
	depends = xdg-utils
	depends = util-linux
	depends = coreutils
	depends = pacman
	depends = libarchive
	depends = glib2
	optdepends = omarchy: the Omarchy 4 shell every plugin runs in; plain Hyprland can run the app but not the plugins
	optdepends = archiso: building ISOs in OmaBuilds
	optdepends = squashfs-tools: building ISOs in OmaBuilds
	optdepends = erofs-utils: EROFS live images in OmaBuilds
	optdepends = plymouth: the boot screen, from Boot Splash
	optdepends = ttfx: the animated boot splash intros (Omarchy repo)
	optdepends = imagemagick: image ASCII art in omascii
	optdepends = matugen: the matugen wallpaper colour scheme
	optdepends = python-pywal16: the pywal wallpaper colour scheme (AUR)
	optdepends = flavours: the flavours wallpaper colour scheme (AUR)
	optdepends = rofi: ROFIoma's popups
	optdepends = wl-clipboard: ROFIoma's emoji and glyph pickers, copying exports
	optdepends = wtype: ROFIoma's pickers typing what is picked
	optdepends = swaync: notifications styled in ROFIoma
	optdepends = python-pyqt6-webengine: Dotfile Generator popped out of OmaCraft into its own window
	optdepends = alienflare: the keyboard lights on Alienware laptops
	options = !debug
